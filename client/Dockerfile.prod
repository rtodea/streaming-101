# Production image: static Vite build served by nginx.
# The dev-mode proxy in vite.config.js (/api, /hls, /slides, /ws -> server)
# is replaced in production by Traefik IngressRoute path rules (see k8s/).
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
