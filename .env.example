# Copy to .env and edit as needed. Values here are empty defaults.
# docker-compose reads this file automatically; variables are passed to the
# client container so Vite picks them up at startup.

# Vite HMR behind a public HTTPS reverse proxy (e.g. timjs.tadeo.ro → localhost:5173).
# Set to 443 + wss when the site is served over HTTPS via a proxy. Leave
# unset for plain http://localhost:5173 dev.
VITE_HMR_CLIENT_PORT=
VITE_HMR_PROTOCOL=
